{
  "id": "novum",
  "title": "Novum",
  "description": "A self-contained combat playtest system for the Novum science-fiction tabletop roleplaying game.",
  "version": "0.1.2",
  "url": "https://github.com/jlabruna/novum-foundry",
  "manifest": "https://raw.githubusercontent.com/jlabruna/novum-foundry/main/system.json",
  "download": "https://github.com/jlabruna/novum-foundry/releases/latest/download/novum.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.368",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Novum Project"
    }
  ],
  "esmodules": [
    "novum.mjs"
  ],
  "styles": [
    "styles/novum.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["notes"]
      },
      "npc": {
        "htmlFields": ["notes"]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": ["description"]
      },
      "armour": {
        "htmlFields": ["description"]
      },
      "armourMod": {
        "htmlFields": ["description"]
      }
    }
  },
  "socket": false,
  "initiative": "1d20 + @attributes.dex.value",
  "grid": {
    "distance": 2,
    "units": "m"
  },
  "primaryTokenAttribute": "resources.health",
  "secondaryTokenAttribute": "resources.shield"
}
